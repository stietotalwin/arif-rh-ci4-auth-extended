{
    "name": "stietotalwin/arif-rh-ci4-auth-extended",
    "description": "PHPAuth for CodeIgniter 4",
    "homepage": "https://github.com/stietotalwin/arif-rh-ci4-auth-extended",
    "keywords": [
        "auth",
        "codeigniter 4 auth",
        "authentication",
        "phpauth"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Arif Rahman Hakim feat. Stie Totalwin",
            "email": "arifrahmanhakim.net@gmail.com"
        },
        {
            "name": "Stie Totalwin",
            "email": "stie.totalwin@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "bjeavons/zxcvbn-php": "^1.0",
        "codeigniter4/framework": "^4.7.4",
        "stietotalwin/arif-rh-ci4-dynamic-model-extended": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "StieTotalWin\\Auth\\": "src"
        }
    },
    "autoload-dev": {
